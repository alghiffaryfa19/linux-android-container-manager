package android.hardware.graphics.common;


@Backing(type="long")
enum BufferUsage {
    CPU_READ_NEVER = 0,
    CPU_READ_RARELY = 2,
    CPU_READ_OFTEN = 3,
    CPU_READ_MASK = 15,
    CPU_WRITE_NEVER = 0,
    CPU_WRITE_RARELY = 32,
    CPU_WRITE_OFTEN = 48,
    CPU_WRITE_MASK = 240,
    GPU_TEXTURE = 256,
    GPU_RENDER_TARGET = 512,
    COMPOSER_OVERLAY = 2048,
    COMPOSER_CLIENT_TARGET = 4096,
    PROTECTED = 16384,
    COMPOSER_CURSOR = 32768,
    VIDEO_ENCODER = 65536,
    CAMERA_OUTPUT = 131072,
    CAMERA_INPUT = 262144,
    RENDERSCRIPT = 1048576,
    VIDEO_DECODER = 4194304,
    SENSOR_DIRECT_DATA = 8388608,
    GPU_DATA_BUFFER = 16777216,
    VENDOR_MASK = -268435456,
}
